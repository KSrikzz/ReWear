# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Supabase Dashboard → Connect → Session pooler → JDBC
# Replace the placeholder password; keep sslmode=require.
SUPABASE_DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres?user=postgres.your-project-ref&password=replace-me&sslmode=require

# Local frontend origin; use the deployed frontend URL in production.
FRONTEND_ORIGIN=http://localhost:5173

# Add trusted administrator emails, separated by commas. Admin roles are assigned only by the server.
REWEAR_ADMIN_EMAILS=

# Configurable platform rules. Rates are decimals (5% = 0.05); these starting values follow the brief's examples.
PLATFORM_CURRENCY=INR
PERSONAL_LISTING_FEE_PERCENT=0.03
PERSONAL_ORDER_COMMISSION_PERCENT=0.05
BUSINESS_SILVER_MONTHLY_PRICE=999
BUSINESS_GOLD_MONTHLY_PRICE=1999
BUSINESS_SILVER_LISTING_FEE_PERCENT=0.08
BUSINESS_GOLD_LISTING_FEE_PERCENT=0.05
PROTECTION_BASE_RATE_PERCENT=0.05
PROTECTION_MIN_PREMIUM=49
PROTECTION_MAX_PREMIUM=499
PROTECTION_STANDARD_CLAIM_WINDOW_HOURS=48
PROTECTION_HIGH_VALUE_CLAIM_WINDOW_HOURS=24
HIGH_VALUE_PRODUCT_THRESHOLD=10000
HIGH_VALUE_PROTECTION_REQUIRED=true
PROTECTION_STANDARD_COVERAGE_LIMIT=5000
PROTECTION_HIGH_VALUE_COVERAGE_LIMIT=10000

# Optional. Without a key, discovery uses its deterministic request interpreter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
